{
    "name": "@jalsoedesign/filezilla-monorepo",
    "private": true,
    "packageManager": "npm@12.0.2",
    "workspaces": [
        "packages/core",
        "packages/cli",
        "packages/connector-abstract",
        "packages/connector-ftp",
        "packages/connector-sftp"
    ],
    "scripts": {
        "build": "turbo run build",
        "test": "turbo run test",
        "test:core": "turbo run test --filter=@jalsoedesign/filezilla-core",
        "test:cli": "turbo run test --filter=@jalsoedesign/filezilla-cli",
        "test:ftp": "turbo run test --filter=@jalsoedesign/filezilla-connector-ftp",
        "test:sftp": "turbo run test --filter=@jalsoedesign/filezilla-connector-sftp",
        "lint": "npm run lint:code && npm run styles:check",
        "docs:install": "npm --prefix docs ci",
        "docs:dev": "npm --prefix docs run dev",
        "docs:build": "npm --prefix docs run build",
        "docs:preview": "npm --prefix docs run preview",
        "dev": "turbo run dev",
        "check:packages": "node scripts/check-packages.mjs",
        "test:shared": "npm run test --workspace=@jalsoedesign/filezilla-connector-abstract",
        "test:profiles": "npm run test:core",
        "check:consumer": "node scripts/check-consumer.mjs",
        "style:check": "eslint --max-warnings 0",
        "style:fix": "eslint --fix --max-warnings 0",
        "test:style": "node --test scripts/eslint/*.test.mjs",
        "lint:fix": "npm run style:fix && npm run styles:fix",
        "lint:code": "eslint . --max-warnings 0",
        "styles:check": "stylelint \"docs/.vitepress/theme/**/*.scss\"",
        "styles:fix": "stylelint \"docs/.vitepress/theme/**/*.scss\" --fix",
        "format": "npm run style:fix && npm run styles:fix",
        "audit:dependencies": "npm audit --offline=false --audit=true --include=dev",
        "audit:production": "npm audit --offline=false --audit=true --omit=dev",
        "audit:docs": "npm --prefix docs audit --offline=false --audit=true --include=dev",
        "check:repository": "node scripts/check-repository.mjs",
        "check:portline-consumer": "node scripts/check-consumer.mjs",
        "pack:local": "node scripts/pack-local.mjs",
        "dev:packages": "node scripts/dev-packages.mjs",
        "check:publication": "node scripts/check-publication.mjs",
        "demo:ftp": "node examples/test-ftp.mjs",
        "demo:sftp": "node examples/test-sftp.mjs",
        "docs:api": "node scripts/generate-api-docs.mjs",
        "docs:api:check": "node scripts/generate-api-docs.mjs --check",
        "docs:imports:check": "node scripts/check-doc-imports.mjs",
        "demo:api": "node examples/test-api.mjs",
        "docs:examples:check": "node scripts/check-doc-examples.mjs",
        "check:locks": "node scripts/check-lockfile.mjs",
        "test:locks": "node --test scripts/check-lockfile.test.mjs",
        "release:lock": "node scripts/release-bootstrap.mjs --lock",
        "check:bootstrap": "node scripts/release-bootstrap.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@jalsoedesign/dockline-abstract": "^1.1.0",
        "@jalsoedesign/dockline-core": "^1.1.0",
        "@jalsoedesign/dockline-ftp-client": "^1.1.0",
        "@jalsoedesign/dockline-sftp-client": "^1.1.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@stylistic/stylelint-plugin": "5.3.1",
        "@types/node": "22.20.5",
        "eslint": "10.14.0",
        "globals": "17.14.0",
        "postcss": "8.5.32",
        "postcss-scss": "4.0.9",
        "stylelint": "17.16.0",
        "tsx": "4.23.15",
        "turbo": "2.11.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.6",
        "vitest": "5.1.0",
        "@jalsoedesign/portline-abstract": "^1.0.0",
        "@jalsoedesign/portline-core": "^1.0.0",
        "@jalsoedesign/portline-platform": "^1.0.0",
        "@jalsoedesign/portline-cli": "^1.0.0"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
        "npm": ">=12.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "cpu-features": false,
        "dtrace-provider": false,
        "ssh2": false
    },
    "overrides": {
        "ftp-srv": {
            "uuid": "11.1.1",
            "ip": "npm:@webpod/ip@0.6.1"
        },
        "minimatch@>=7 <11.0.1": "11.0.5"
    },
    "version": "1.0.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h2ooooooo/filezilla-js.git"
    },
    "homepage": "https://h2ooooooo.github.io/filezilla-js/",
    "bugs": {
        "url": "https://github.com/h2ooooooo/filezilla-js/issues"
    }
}
