{
    "name": "@jalsoedesign/filezilla-connector-sftp",
    "version": "1.0.0",
    "type": "module",
    "description": "FileZilla saved-site SFTP mapping, read-only host-key import and Dockline compatibility exports",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "node ../../scripts/build-package.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "tsc --watch",
        "lint": "eslint src tests --no-error-on-unmatched-pattern --max-warnings 0",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@jalsoedesign/filezilla-connector-abstract": "^1.0.0",
        "fast-xml-parser": "5.11.1",
        "@jalsoedesign/dockline-sftp-client": "^1.0.0"
    },
    "peerDependencies": {
        "@jalsoedesign/filezilla-core": "^1.0.0"
    },
    "devDependencies": {
        "@jalsoedesign/filezilla-core": "^1.0.0",
        "ssh2": "1.17.0",
        "vitest": "5.0.0",
        "typescript": "6.0.3",
        "@types/node": "22.20.2",
        "@types/ssh2": "1.15.6",
        "ssh2-sftp-client": "12.1.1"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.22.2"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./dist/*": "./dist/*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h2ooooooo/filezilla-js.git",
        "directory": "packages/connector-sftp"
    },
    "homepage": "https://h2ooooooo.github.io/filezilla-js/",
    "bugs": {
        "url": "https://github.com/h2ooooooo/filezilla-js/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
