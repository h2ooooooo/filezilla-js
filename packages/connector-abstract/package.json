{
    "name": "@jalsoedesign/filezilla-connector-abstract",
    "version": "1.0.0",
    "type": "module",
    "description": "FileZilla connector factory and registry with shared Dockline compatibility exports",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "node ../../scripts/build-package.mjs",
        "dev": "tsc --watch",
        "lint": "eslint src tests --no-error-on-unmatched-pattern --max-warnings 0",
        "prepack": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@jalsoedesign/filezilla-core": "^1.0.0"
    },
    "devDependencies": {
        "@jalsoedesign/filezilla-core": "^1.0.0",
        "typescript": "6.0.3",
        "vitest": "5.0.0"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.22.2"
    },
    "files": [
        "dist",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./dist/*": "./dist/*"
    },
    "dependencies": {
        "@flystorage/file-storage": "1.2.2",
        "@jalsoedesign/dockline-abstract": "^1.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h2ooooooo/filezilla-js.git",
        "directory": "packages/connector-abstract"
    },
    "homepage": "https://h2ooooooo.github.io/filezilla-js/",
    "bugs": {
        "url": "https://github.com/h2ooooooo/filezilla-js/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
